# --- Database Configuration ---
MYSQL_DATABASE=mini_whatsapp
# Use the format: mysql+pymysql://user:password@host:port/db_name
SQLALCHEMY_DATABASE_URI=mysql+pymysql://root:rootpassword@localhost:3306/mini_whatsapp
